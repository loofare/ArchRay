{
  "name": "archray",
  "version": "0.2.0",
  "description": "AI-driven living system architecture visual engine (AI Skill + zero-runtime-dependency 2.5D isometric interactive sandbox)",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "viewer"
  ],
  "bin": {
    "archray": "./cli/bin/archray.mjs"
  },
  "scripts": {
    "dev": "npm --workspace=viewer run dev",
    "test": "npm --workspace=core run test",
    "typecheck": "npm --workspace=core run typecheck && npm --workspace=viewer run typecheck",
    "gen:schema": "node --import tsx scripts/gen-schema.ts",
    "build:viewer": "npm --workspace=viewer run build",
    "build:cli": "node --import tsx scripts/build-cli.ts",
    "build": "npm run gen:schema && npm run build:viewer && npm run build:cli",
    "self-analyze": "node cli/bin/archray.mjs build .archray/graph.json --no-open"
  },
  "keywords": [
    "architecture",
    "visualization",
    "isometric",
    "ai-skill",
    "elkjs",
    "c4-model"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.19.0",
    "esbuild": "^0.25.0"
  }
}
