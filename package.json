{
  "name": "archray",
  "version": "0.4.0",
  "description": "AI-first architecture visualiser: a Skill + CLI that turns a repository into layered, interactive, offline HTML views.",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "viewer"
  ],
  "bin": {
    "archray": "./cli/bin/archray.mjs"
  },
  "scripts": {
    "dev": "npm --workspace=viewer run dev",
    "test": "npm --workspace=core run test",
    "typecheck": "npm --workspace=core run typecheck && npm --workspace=viewer run typecheck",
    "gen:schema": "node --import tsx scripts/gen-schema.ts",
    "build:viewer": "npm --workspace=viewer run build",
    "build:cli": "node --import tsx scripts/build-cli.ts",
    "build": "npm run gen:schema && npm run gen:brands && npm run gen:knowledge && npm run build:viewer && npm run build:cli",
    "self-analyze": "node scripts/self-analyze.mjs",
    "gen:brands": "node scripts/gen-brands.mjs",
    "check:sensitive": "node scripts/check-sensitive.mjs",
    "gen:knowledge": "node scripts/gen-knowledge.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:package": "npm run package && node scripts/package-check.mjs",
    "test:hosts": "node scripts/check-pi.mjs",
    "test:brands": "node --import tsx scripts/check-brands.mjs"
  },
  "keywords": [
    "architecture",
    "visualization",
    "ai-skill",
    "slash-commands",
    "layered-architecture",
    "c4-model",
    "elkjs",
    "offline-html"
  ],
  "license": "MIT",
  "devDependencies": {
    "@iconify-json/logos": "^1.2.20",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  }
}
